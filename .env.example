# ============================================================
# AffiliateBot — 環境変数サンプル
# このファイルをコピーして .env を作成し、実際の値を設定してください
# cp .env.example .env
# ============================================================

# ----- 動作モード -----
TEST_MODE=false          # true にすると実際に投稿せずコンソール表示のみ

# ----- Threads API -----
# Meta Developer App から取得（Long-Lived Token・90日有効）
THREADS_USER_ID=         # 数値のユーザーID
THREADS_ACCESS_TOKEN=    # Long-Lived Access Token
THREADS_APP_ID=          # App ID
THREADS_APP_SECRET=      # App Secret（トークン更新に使用）

# ----- Instagram Graph API -----
# mono_zukan_jp アカウント（デフォルト）
INSTAGRAM_ACCESS_TOKEN=  # Long-Lived Token（60日ごと自動更新）
INSTAGRAM_USER_ID=       # Instagram Business アカウントID
INSTAGRAM_APP_ID=        # App ID
INSTAGRAM_APP_SECRET=    # App Secret

# osakezukan_jp アカウント用（追加アカウントはenv変数名をaccounts.jsonで指定）
INSTAGRAM_ACCESS_TOKEN_OSAKE=
INSTAGRAM_USER_ID_OSAKE=

# hobbyzukan_jp アカウント用
INSTAGRAM_ACCESS_TOKEN_HOBBY=
INSTAGRAM_USER_ID_HOBBY=

# ----- Bluesky -----
BLUESKY_HANDLE=          # 例: yourhandle.bsky.social
BLUESKY_APP_PASSWORD=    # App Password（Bluesky設定画面で生成）

# ----- 楽天 API -----
# https://webservice.rakuten.co.jp/ で取得
RAKUTEN_APP_ID=          # アプリID
RAKUTEN_ACCESS_KEY=      # アクセスキー
RAKUTEN_AFFILIATE_ID=    # アフィリエイトID

# ----- Amazon アソシエイト -----
AMAZON_ASSOCIATE_ID=     # 例: yourstore-22

# ----- LLM APIs -----
ANTHROPIC_API_KEY=       # Claude API（claude-haiku-4-5 使用）
OPENAI_API_KEY=          # OpenAI API（投稿文生成に使用）

# ----- Discord 通知 -----
# Discord サーバーのWebhook URL（チャンネルごとに設定）
DISCORD_WEBHOOK_URL=     # 通常ログ・投稿完了通知
DISCORD_WEBHOOK_ERROR=   # エラー通知専用チャンネル
DISCORD_WEBHOOK_REPORT=  # 週次レポート専用チャンネル
DISCORD_BOT_TOKEN=       # Discord Bot Token（コメント返信botに使用）

# ----- 画像ホスティング -----
# Cloudinary（Instagram 投稿画像のホスティング）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# imgBB（サブ画像ホスティング）
IMGBB_API_KEY=

# ----- X (Twitter) API -----
# 現在は APIクレジット有料のため無効化中（コードは残存）
X_BEARER_TOKEN=
X_CONSUMER_KEY=
X_CONSUMER_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# ----- 価格フィルター（任意）-----
PRICE_FILTER_MIN=500     # 投稿対象の最低価格（円）
PRICE_FILTER_MAX=5000    # 投稿対象の最高価格（円）
